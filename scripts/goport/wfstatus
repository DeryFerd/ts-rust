#!/usr/bin/env python3
"""Workflow status for the ts-rust Claude sessions, without hand-parsing journal.jsonl.

usage: wfstatus [--all] [--session ID]   one line per workflow: state, name, agents done/started,
                                         running labels, age. Default: running ones and the last 8.
       wfstatus <run-id> [--full]        each agent's label, phase and result (600 chars, or all),
                                         then the workflow's return value when it has finished.
Reads ~/.claude/projects/<ts-rust>/<session>/{workflows,subagents/workflows}. The newest session
is the default; --session picks another (a prefix is enough).
"""
import argparse, glob, json, os, sys, time

PROJECT = os.path.expanduser('~/.claude/projects/-home-theo-Code-sandbox-ts-rust')


def sessions():
    dirs = [d for d in glob.glob(f'{PROJECT}/*/') if os.path.isdir(f'{d}subagents/workflows')]
    return sorted(dirs, key=lambda d: os.path.getmtime(f'{d}subagents/workflows'))


def load_run(session, run):
    """(summary dict, per-agent list) for one workflow run."""
    agents, results = {}, {}
    journal = f'{session}subagents/workflows/{run}/journal.jsonl'
    with open(journal) as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get('type') == 'started':
                agents[d['agentId']] = {'label': d.get('label'), 'phase': d.get('phase')}
            elif d.get('type') == 'result':
                results[d.get('agentId')] = d.get('result')
    meta_path = f'{session}workflows/{run}.json'
    meta = json.load(open(meta_path)) if os.path.exists(meta_path) else {}
    # Script files live under the project dir of the session's cwd at launch, which can be a worktree.
    sid = os.path.basename(session.rstrip('/'))
    scripts = glob.glob(f'{PROJECT}*/{sid}/workflows/scripts/*{run}.js')
    name = meta.get('workflowName') or next((os.path.basename(p)[:-len(run) - 4] for p in scripts), '?')
    rows = [{**a, 'agentId': k, 'done': k in results, 'result': results.get(k)} for k, a in agents.items()]
    return {'run': run, 'name': name, 'state': meta.get('status', 'running'), 'meta': meta,
            'age': time.time() - os.path.getmtime(journal), 'started': os.path.getctime(journal)}, rows


def fmt_age(s):
    return f'{s / 3600:.1f}h' if s >= 3600 else f'{s / 60:.0f}m'


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument('run', nargs='?')
    ap.add_argument('--all', action='store_true')
    ap.add_argument('--full', action='store_true')
    ap.add_argument('--session')
    ap.add_argument('-h', '--help', action='store_true')
    a = ap.parse_args()
    if a.help:
        print(__doc__.strip())
        return
    all_sessions = sessions()
    if a.session:
        all_sessions = [s for s in all_sessions if os.path.basename(s.rstrip('/')).startswith(a.session)]
    if not all_sessions:
        sys.exit('wfstatus: no session with workflows')
    session = all_sessions[-1]
    runs = sorted(os.listdir(f'{session}subagents/workflows'))
    if a.run:
        match = [r for r in runs if r.startswith(a.run) or r == f'wf_{a.run}']
        if len(match) != 1:
            sys.exit(f'wfstatus: {len(match)} runs match {a.run}')
        info, rows = load_run(session, match[0])
        print(f"{info['run']} {info['name']} {info['state']}, {sum(r['done'] for r in rows)}/{len(rows)} agents done")
        for r in rows:
            text = r['result'] if isinstance(r['result'], str) else json.dumps(r['result'])
            if r['done'] and not a.full and len(text) > 600:
                text = text[:600] + ' ...'
            print(f"\n## {r['label']} [{r['phase']}] {'done' if r['done'] else 'RUNNING'} ({r['agentId']})")
            if r['done']:
                print(text)
        if info['meta'].get('result') is not None:
            print('\n## workflow result\n' + json.dumps(info['meta']['result'], indent=1)[:None if a.full else 4000])
        return
    infos = sorted((load_run(session, r) for r in runs), key=lambda x: x[0]['started'])
    running = [x for x in infos if x[0]['state'] == 'running']
    shown = infos if a.all else [x for x in infos if x in running or x in infos[-8:]]
    print(f'session {os.path.basename(session.rstrip("/"))}: {len(running)} running, {len(infos)} runs')
    for info, rows in shown:
        busy = [r['label'] for r in rows if not r['done']]
        tail = f" running: {', '.join(busy[:6])}{' ...' if len(busy) > 6 else ''}" if busy else ''
        print(f"{info['state']:<9} {info['run']} {info['name'][:34]:<34} {sum(r['done'] for r in rows):>3}/{len(rows):<3}"
              f" last event {fmt_age(info['age'])} ago{tail}")


if __name__ == '__main__':
    main()
