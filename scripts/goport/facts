#!/usr/bin/env python3
"""Paths and versions a goport agent looks up before its first edit, in one call (about 40 lines).

usage: scripts/goport/facts [section...]   sections: main accepted pins inputs bins worktrees gates (default: all)

main       main HEAD and how far it is from origin/main (as of the last fetch)
accepted   the accepted revision from the saved state: commit, source fingerprint, checkout, gate, bins
           (checked against the gate manifest), quality evidence and Go pin
pins       each Go pin in UPSTREAM.json with its checkout and oracle; the default pin and the pin of main
inputs     the four project tsconfigs (read-only) and whether their sources are locked
bins       the 10 newest lane bin dirs (a COMMIT file, 3 days): commit and age
worktrees  target/worktrees/goport-* with commits that main lacks or with changed files: branch, head, age
gates      the last 6 gates: verdict, commit, pin, bins
Local reads only: no fetch, no ssh. Host locks and load: scripts/goport/remote.sh status.
"""
import glob, hashlib, json, os, subprocess, sys, time

REPO = '/home/theo/Code/sandbox/ts-rust'
R = f'{REPO}/target/continuation-r97-goport'
HOME = os.path.expanduser('~')
INPUTS = {'query': 'query/source/packages/query-core/tsconfig.prod.json', 'hono': 'hono/source/tsconfig.build.json',
          'zod': 'zod/source/packages/zod/tsconfig.json', 'effect': 'effect/source/packages/effect/tsconfig.json'}


def git(*args, cwd=REPO):
    return subprocess.run(['git', '-C', cwd, *args], capture_output=True, text=True).stdout.strip()


def short(p):
    p = str(p)
    return p[len(REPO) + 1:] if p.startswith(REPO + '/') else '~' + p[len(HOME):] if p.startswith(HOME + '/') else p


def age(t):
    s = time.time() - t
    return f'{s / 60:.0f}m' if s < 3600 else f'{s / 3600:.0f}h' if s < 172800 else f'{s / 86400:.0f}d'


def load(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def main_():
    ahead, behind = (git('rev-list', '--left-right', '--count', 'main...origin/main').split() + ['?', '?'])[:2]
    fetched = age(os.path.getmtime(f'{REPO}/.git/FETCH_HEAD')) if os.path.exists(f'{REPO}/.git/FETCH_HEAD') else '?'
    print(f'main       {git("log", "-1", "--format=%h %s", "main")[:90]}')
    print(f'           {ahead} ahead, {behind} behind origin/main (fetched {fetched} ago)')


def accepted():
    cur = load(f'{REPO}/docs/typechecker-state/current.json')
    b = cur.get('batch', {})
    if not b.get('compilerAccepted'):
        # A revision is open: the accepted one is the last archived batch record.
        opened = f"open R{b.get('recoveryRevision')} in {b.get('id')}; "
        recs = cur.get('batchRecords') or []
        b = load(f"{REPO}/{recs[-1]['path']}") if recs else {}
    else:
        opened = ''
    if opened:
        print(f'open       {opened[5:].rstrip("; ")}')
    pin = (b.get('upstreamPin') or {}).get('to', '?')
    print(f'accepted   R{b.get("recoveryRevision")} commit {b.get("commit")} fp {b.get("sourceFingerprint", "")[:12]} '
          f'checkout {b.get("checkout")} Go pin {pin}')
    g = load(f'{REPO}/{(b.get("gate") or {}).get("manifest", "")}') if (b.get("gate") or {}).get("manifest") else {}
    bins = g.get('binaries', {})
    ok = sum(os.path.exists(v['path']) and sha256(v['path']) == v['sha256'] for v in bins.values())
    print(f'           gate {g.get("label")} {g.get("verdict")}; bins {short(g.get("binsDir", "?"))} '
          f'({ok} of {len(bins)} match the gate manifest; tsgo is there too)')
    print(f'           quality evidence {(b.get("qualityEvidence") or {}).get("dir")}')


def pins():
    u = load(f'{REPO}/UPSTREAM.json')
    main_pin = load(f'{REPO}/docs/typechecker-state/current.json').get('batch', {}).get('upstreamPin', {}).get('to')
    for key, p in u.get('pins', {}).items():
        tags = [t for t, on in (('default', key == u.get('current')), ('main', key == main_pin)) if on]
        print(f'{"pins" if key == next(iter(u["pins"])) else "":10} {key} {",".join(tags):12} Go {short(p["goCheckout"])}  '
              f'oracle {short(p["oracle"]["path"])}')
    if main_pin and main_pin != u.get('current'):
        print(f'           main work: GOPORT_PIN={main_pin} scripts/upstream/pin.py exec -- <command>. '
              'Do not read Go source in the default checkout for main work.')


def inputs():
    for i, (name, rel) in enumerate(INPUTS.items()):
        src = f'{REPO}/target/project-inputs/{name}/source'
        lock = 'read-only' if not os.access(src, os.W_OK) else 'WRITABLE: scripts/project-inputs.sh lock'
        print(f'{"inputs" if i == 0 else "":10} {name:7} target/project-inputs/{rel} ({lock})')


def bin_dirs(d=R, depth=0):
    """Dirs with a COMMIT file, 4 levels deep. Data dirs (over 100 entries) are not entered: a full walk takes 10 s."""
    try:
        es = list(os.scandir(d))
    except OSError:
        return
    if any(e.name == 'COMMIT' for e in es):
        yield d
    if depth < 4 and (depth == 0 or len(es) <= 100):
        for e in es:
            if e.is_dir(follow_symlinks=False):
                yield from bin_dirs(e.path, depth + 1)


def bins():
    cut, rows = time.time() - 3 * 86400, []
    for d in bin_dirs():
        commit = (open(f'{d}/COMMIT').read().split() or ['?'])[0]
        t = os.path.getmtime(f'{d}/COMMIT')
        if t > cut and all(c in '0123456789abcdef' for c in commit):
            sums = 'bins.sha256' if os.path.exists(f'{d}/bins.sha256') else 'no bins.sha256'
            rows.append((t, f'{short(d):50} {commit[:9]} {age(t)} ago, {sums}'))
    for i, (_, row) in enumerate(sorted(rows, reverse=True)[:10]):
        print(f'{"bins" if i == 0 else "":10} {row}')


def worktrees():
    rows = []
    for wt in glob.glob(f'{REPO}/target/worktrees/goport-*'):
        ahead = git('rev-list', '--count', 'main..HEAD', cwd=wt)
        dirty = len(git('status', '--porcelain', '--untracked-files=no', cwd=wt).splitlines())
        if ahead not in ('', '0') or dirty:
            head = git('log', '-1', '--format=%ct %h', cwd=wt).split()
            rows.append((int(head[0]), f'{short(wt):36} {git("branch", "--show-current", cwd=wt):22} {head[1]} '
                                       f'+{ahead} on main, {dirty} changed, {age(int(head[0]))} ago'))
    for i, (_, row) in enumerate(sorted(rows, reverse=True)[:12]):
        print(f'{"worktrees" if i == 0 else "":10} {row}')
    if len(rows) > 12:
        print(f'           ... {len(rows) - 12} older')


def gates():
    dirs = sorted(glob.glob(f'{R}/compat/gate/*/'), key=os.path.getmtime, reverse=True)[:6]
    for i, d in enumerate(dirs):
        m = load(f'{d}manifest.json')
        info = (f'{m.get("verdict", "running?")} {m.get("commit", "?")[:9]} pin {m.get("upstreamPin", "?")} '
                f'bins {short(m.get("binsDir", "?"))}') if m else 'no manifest yet'
        print(f'{"gates" if i == 0 else "":10} {os.path.basename(d[:-1]):16} {age(os.path.getmtime(d))} ago {info}')
    print('           results: <gate dir>/manifest.json (verdict, binsDir, commit, upstreamPin, results)')


SECTIONS = {'main': main_, 'accepted': accepted, 'pins': pins, 'inputs': inputs, 'bins': bins,
            'worktrees': worktrees, 'gates': gates}

if __name__ == '__main__':
    names = sys.argv[1:] or list(SECTIONS)
    if any(n not in SECTIONS for n in names):
        sys.exit(__doc__.strip())
    for n in names:
        SECTIONS[n]()
