{
  "compilerOptions": {
    "strict": true, "noEmit": true, "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ESNext", "skipLibCheck": true,
    "plugins": [{ "name": "@effect/language-service", "ignoreEffectWarningsInTscExitCode": true, "diagnosticSeverity": { "floatingEffect": "warning" } }]
  },
  "include": ["src"]
}
