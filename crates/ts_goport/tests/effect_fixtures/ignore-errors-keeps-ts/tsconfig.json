  "compilerOptions": {
    "strict": true, "noEmit": true, "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ESNext", "skipLibCheck": true,
    "plugins": [{ "name": "@effect/language-service", "ignoreEffectErrorsInTscExitCode": true, "diagnosticSeverity": { "globalDate": "error" } }]
  },
  "include": ["src"]
}
